{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{ci/**,vorlagen/vorlagen.json}",
      "maxDuration": 10
    },
    "api/vorlage.js": {
      "includeFiles": "vorlagen/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/vorlagen/:key/:file",
      "destination": "/api/vorlage?key=:key&file=:file"
    }
  ]
}