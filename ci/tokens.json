{
  "$description": "CASI Design Tokens (W3C DTCG-Format). Muss zu ci/SKILL.md passen – npm run check prüft das.",
  "color": {
    "page": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Page",
      "$extensions": {
        "org.casinitiative.cssVar": "--papier"
      }
    },
    "box": {
      "$type": "color",
      "$value": "#EEF2F1",
      "$description": "Box, band",
      "$extensions": {
        "org.casinitiative.cssVar": "--block"
      }
    },
    "text": {
      "$type": "color",
      "$value": "#0E4D49",
      "$description": "Deep Green – all text, headings, hairlines, outline button",
      "$extensions": {
        "org.casinitiative.cssVar": "--tinte"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#5F7471",
      "$description": "Slate – meta, captions, footnotes, page numbers, footer",
      "$extensions": {
        "org.casinitiative.cssVar": "--leise"
      }
    },
    "rule": {
      "$type": "color",
      "$value": "#E1E7E5",
      "$description": "Light rule",
      "$extensions": {
        "org.casinitiative.cssVar": "--linie"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#8B1538",
      "$description": "Burgundy – filled button, current menu item, call to action; at most twice per page",
      "$extensions": {
        "org.casinitiative.cssVar": "--akzent"
      }
    },
    "box-edge": {
      "$type": "color",
      "$value": "#C5D4D3",
      "$description": "Box edge (white box on grey), divider inside a grey box"
    },
    "connector": {
      "$type": "color",
      "$value": "#93AFAD",
      "$description": "Connectors in diagrams the author drew"
    }
  },
  "colorExtra": {
    "$description": "Extra colours from the website graphics. Only for graphics, charts, diagrams and illustrations – never for text, headings, buttons, boxes or decoration.",
    "icca": {
      "$type": "color",
      "$value": "#13917C",
      "$description": "ICCA green – ICCA marks, system diagrams (website --icca)",
      "$extensions": {
        "org.casinitiative.cssVar": "--icca"
      }
    },
    "icca-grafik": {
      "$type": "color",
      "$value": "#1A9C7E",
      "$description": "ICCA green in the hero graphic"
    },
    "burgundy-hell": {
      "$type": "color",
      "$value": "#F6EBEF",
      "$description": "Burgundy tint, light – hero flow areas"
    },
    "burgundy-mittel": {
      "$type": "color",
      "$value": "#CB96A6",
      "$description": "Burgundy tint, mid – hero flow lines"
    },
    "kette-direct": {
      "$type": "color",
      "$value": "#29363D",
      "$description": "Value chain: direct",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-direct"
      }
    },
    "kette-iron": {
      "$type": "color",
      "$value": "#8C5A3C",
      "$description": "Value chain: iron",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-iron"
      }
    },
    "kette-steel": {
      "$type": "color",
      "$value": "#5B7C99",
      "$description": "Value chain: steel",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-steel"
      }
    },
    "kette-car": {
      "$type": "color",
      "$value": "#3F6B3F",
      "$description": "Value chain: car",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-car"
      }
    },
    "kette-body": {
      "$type": "color",
      "$value": "#0E8388",
      "$description": "Value chain: body",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-body"
      }
    },
    "kette-leben": {
      "$type": "color",
      "$value": "#6B4C6E",
      "$description": "Value chain: end of life",
      "$extensions": {
        "org.casinitiative.cssVar": "--kette-leben"
      }
    },
    "x1": {
      "$type": "color",
      "$value": "#B060E0",
      "$description": "Data / transaction marker A",
      "$extensions": {
        "org.casinitiative.cssVar": "--x1"
      }
    },
    "x2": {
      "$type": "color",
      "$value": "#3060C0",
      "$description": "Data / transaction marker B",
      "$extensions": {
        "org.casinitiative.cssVar": "--x2"
      }
    },
    "x3": {
      "$type": "color",
      "$value": "#2080B0",
      "$description": "Data / transaction marker C",
      "$extensions": {
        "org.casinitiative.cssVar": "--x3"
      }
    },
    "x4": {
      "$type": "color",
      "$value": "#50B0D0",
      "$description": "Data / transaction marker D",
      "$extensions": {
        "org.casinitiative.cssVar": "--x4"
      }
    },
    "x5": {
      "$type": "color",
      "$value": "#20C090",
      "$description": "Data / transaction marker E",
      "$extensions": {
        "org.casinitiative.cssVar": "--x5"
      }
    },
    "x6": {
      "$type": "color",
      "$value": "#30A060",
      "$description": "Data / transaction marker F",
      "$extensions": {
        "org.casinitiative.cssVar": "--x6"
      }
    },
    "x7": {
      "$type": "color",
      "$value": "#E08820",
      "$description": "Data / transaction marker G",
      "$extensions": {
        "org.casinitiative.cssVar": "--x7"
      }
    },
    "x8": {
      "$type": "color",
      "$value": "#D06020",
      "$description": "Data / transaction marker H",
      "$extensions": {
        "org.casinitiative.cssVar": "--x8"
      }
    },
    "x9": {
      "$type": "color",
      "$value": "#E04040",
      "$description": "Data / transaction marker I",
      "$extensions": {
        "org.casinitiative.cssVar": "--x9"
      }
    },
    "x10": {
      "$type": "color",
      "$value": "#C04080",
      "$description": "Data / transaction marker J",
      "$extensions": {
        "org.casinitiative.cssVar": "--x10"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "PP Mori",
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$description": "Everything that names, orders, counts or points: titles, headings, labels, tables, charts, navigation, all slide text"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Serif",
        "Georgia",
        "serif"
      ],
      "$description": "Text read as sentences: paragraphs, footnotes, abstracts, quotations, web body text"
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    }
  },
  "radius": {
    "box": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "panel": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    }
  },
  "asset": {
    "logo": "https://casinitiative.org/wp-content/uploads/2026/07/LOGO.svg",
    "logoC": "https://ci.casinitiative.org/marke/casi-c-tinte.svg",
    "logoCWhite": "https://ci.casinitiative.org/marke/casi-c-weiss.svg",
    "logoCPng": "https://ci.casinitiative.org/marke/casi-c-tinte.png",
    "logoMail": "https://casinitiative.org/wp-content/uploads/casi-mail/casi-logo-mail.png",
    "fonts": "https://casinitiative.org/wp-content/uploads/casi-fonts/"
  }
}
