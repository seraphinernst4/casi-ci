{
  "$description": "CASI Design Tokens (W3C DTCG-Format). Muss zu ci/SKILL.md passen – npm run check prüft das.",
  "color": {
    "page": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Page",
      "$extensions": {
        "org.casinitiative.cssVar": "--papier"
      }
    },
    "box": {
      "$type": "color",
      "$value": "#EEF2F1",
      "$description": "Box, band",
      "$extensions": {
        "org.casinitiative.cssVar": "--block"
      }
    },
    "text": {
      "$type": "color",
      "$value": "#0E4D49",
      "$description": "Deep Green – all text, headings, hairlines, outline button",
      "$extensions": {
        "org.casinitiative.cssVar": "--tinte"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#5F7471",
      "$description": "Slate – meta, captions, footnotes, page numbers, footer",
      "$extensions": {
        "org.casinitiative.cssVar": "--leise"
      }
    },
    "rule": {
      "$type": "color",
      "$value": "#E1E7E5",
      "$description": "Light rule",
      "$extensions": {
        "org.casinitiative.cssVar": "--linie"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#8B1538",
      "$description": "Burgundy – filled button, current menu item, call to action; at most twice per page",
      "$extensions": {
        "org.casinitiative.cssVar": "--akzent"
      }
    },
    "box-edge": {
      "$type": "color",
      "$value": "#C5D4D3",
      "$description": "Box edge (white box on grey), divider inside a grey box"
    },
    "connector": {
      "$type": "color",
      "$value": "#93AFAD",
      "$description": "Connectors in diagrams the author drew"
    }
  },
  "colorExtra": {
    "$description": "Extra colours from the website graphics. Only for graphics, charts, diagrams and illustrations – never for text, headings, buttons, boxes or decoration.",
    "icca": {
      "$type": "color",
      "$value": "#13917C",
      "$description": "ICCA green – ICCA marks, system diagrams (website --icca)",
      "$extensions": {
        "org.casinitiative.cssVar": "--icca"
      }
    },
    "icca-grafik": {
      "$type": "color",
      "$value": "#1A9C7E",
      "$description": "ICCA green in the hero graphic"
    },
    "burgundy-hell": {
      "$type": "color",
      "$value": "#F6EBEF",
      "$description": "Burgundy tint, light – hero flow areas"
    },
    "burgundy-mittel": {
      "$type": "color",
      "$value": "#CB96A6",
      "$description": "Burgundy tint, mid – hero flow lines"
    },
    "kette-direct": {
      "$type": "color",
      "$value": "#29363D",
      "$description": "Value chain: direct / own contribution text (graphic ink)"
    },
    "kette-iron": {
      "$type": "color",
      "$value": "#A75F26",
      "$description": "Value chain field: iron (white text)"
    },
    "kette-steel": {
      "$type": "color",
      "$value": "#1A6685",
      "$description": "Value chain field: steel (white text)"
    },
    "kette-body": {
      "$type": "color",
      "$value": "#17876F",
      "$description": "Value chain field: body (white text)"
    },
    "kette-car": {
      "$type": "color",
      "$value": "#2A7A4B",
      "$description": "Value chain field: car (white text)"
    },
    "kette-leben": {
      "$type": "color",
      "$value": "#85499E",
      "$description": "Value chain field: end of life (white text)"
    },
    "grafik-leise": {
      "$type": "color",
      "$value": "#54626A",
      "$description": "Secondary text inside graphics"
    },
    "burgundy-rose": {
      "$type": "color",
      "$value": "#E3C2CD",
      "$description": "Burgundy tint for outlines in graphics"
    },
    "x1": {
      "$type": "color",
      "$value": "#B060E0",
      "$description": "Data / transaction marker A",
      "$extensions": {
        "org.casinitiative.cssVar": "--x1"
      }
    },
    "x2": {
      "$type": "color",
      "$value": "#3060C0",
      "$description": "Data / transaction marker B",
      "$extensions": {
        "org.casinitiative.cssVar": "--x2"
      }
    },
    "x3": {
      "$type": "color",
      "$value": "#2080B0",
      "$description": "Data / transaction marker C",
      "$extensions": {
        "org.casinitiative.cssVar": "--x3"
      }
    },
    "x4": {
      "$type": "color",
      "$value": "#50B0D0",
      "$description": "Data / transaction marker D",
      "$extensions": {
        "org.casinitiative.cssVar": "--x4"
      }
    },
    "x5": {
      "$type": "color",
      "$value": "#20C090",
      "$description": "Data / transaction marker E",
      "$extensions": {
        "org.casinitiative.cssVar": "--x5"
      }
    },
    "x6": {
      "$type": "color",
      "$value": "#30A060",
      "$description": "Data / transaction marker F",
      "$extensions": {
        "org.casinitiative.cssVar": "--x6"
      }
    },
    "x7": {
      "$type": "color",
      "$value": "#E08820",
      "$description": "Data / transaction marker G",
      "$extensions": {
        "org.casinitiative.cssVar": "--x7"
      }
    },
    "x8": {
      "$type": "color",
      "$value": "#D06020",
      "$description": "Data / transaction marker H",
      "$extensions": {
        "org.casinitiative.cssVar": "--x8"
      }
    },
    "x9": {
      "$type": "color",
      "$value": "#E04040",
      "$description": "Data / transaction marker I",
      "$extensions": {
        "org.casinitiative.cssVar": "--x9"
      }
    },
    "x10": {
      "$type": "color",
      "$value": "#C04080",
      "$description": "Data / transaction marker J",
      "$extensions": {
        "org.casinitiative.cssVar": "--x10"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "PP Mori",
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$description": "Everything that names, orders, counts or points: titles, headings, labels, tables, charts, navigation, all slide text"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Serif",
        "Georgia",
        "serif"
      ],
      "$description": "Text read as sentences: paragraphs, footnotes, abstracts, quotations, web body text"
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    }
  },
  "radius": {
    "box": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "panel": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    }
  },
  "asset": {
    "logo": "https://casinitiative.org/wp-content/uploads/2026/07/LOGO.svg",
    "logoC": "https://ci.casinitiative.org/marke/casi-c-tinte.svg",
    "logoCWhite": "https://ci.casinitiative.org/marke/casi-c-weiss.svg",
    "logoCPng": "https://ci.casinitiative.org/marke/casi-c-tinte.png",
    "logoMail": "https://casinitiative.org/wp-content/uploads/casi-mail/casi-logo-mail-deepgreen.png",
    "fonts": "https://casinitiative.org/wp-content/uploads/casi-fonts/",
    "symbols": "https://ci.casinitiative.org/marke/symbole/"
  },
  "graphic": {
    "$description": "Rules of the website graphics (casi-proposal.css / casi-wp.css .abb) – for every CASI-made graphic.",
    "hairline": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      },
      "$description": "Lines and box outlines, Deep Green (or #E1E7E5 for quiet rules)"
    },
    "symbolStroke": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "px"
      },
      "$description": "Symbol stroke at 24 px, round caps and joins, no fill"
    },
    "radiusBox": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "radiusSmall": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "radiusMark": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Marks A–J, about 2:1"
    }
  }
}
