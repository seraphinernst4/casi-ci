{
  "$description": "CASI Design Tokens (W3C DTCG-Format). Muss zu ci/SKILL.md passen – npm run check prüft das.",
  "color": {
    "page": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Page",
      "$extensions": { "org.casinitiative.cssVar": "--papier" }
    },
    "box": {
      "$type": "color",
      "$value": "#EEF2F1",
      "$description": "Box, band",
      "$extensions": { "org.casinitiative.cssVar": "--block" }
    },
    "text": {
      "$type": "color",
      "$value": "#0E4D49",
      "$description": "Deep Green – all text, headings, hairlines, outline button",
      "$extensions": { "org.casinitiative.cssVar": "--tinte" }
    },
    "secondary": {
      "$type": "color",
      "$value": "#5F7471",
      "$description": "Slate – meta, captions, footnotes, page numbers, footer",
      "$extensions": { "org.casinitiative.cssVar": "--leise" }
    },
    "rule": {
      "$type": "color",
      "$value": "#E1E7E5",
      "$description": "Light rule",
      "$extensions": { "org.casinitiative.cssVar": "--linie" }
    },
    "accent": {
      "$type": "color",
      "$value": "#8B1538",
      "$description": "Burgundy – filled button, current menu item, call to action; at most twice per page",
      "$extensions": { "org.casinitiative.cssVar": "--akzent" }
    },
    "box-edge": {
      "$type": "color",
      "$value": "#C5D4D3",
      "$description": "Box edge (white box on grey), divider inside a grey box"
    },
    "connector": {
      "$type": "color",
      "$value": "#93AFAD",
      "$description": "Connectors in diagrams the author drew"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["PP Mori", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
      "$description": "Everything that names, orders, counts or points: titles, headings, labels, tables, charts, navigation, all slide text"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Serif", "Georgia", "serif"],
      "$description": "Text read as sentences: paragraphs, footnotes, abstracts, quotations, web body text"
    }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "semibold": { "$type": "fontWeight", "$value": 600 }
  },
  "radius": {
    "box": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
  },
  "asset": {
    "logo": "https://casinitiative.org/wp-content/uploads/2026/07/LOGO.svg",
    "logoMail": "https://casinitiative.org/wp-content/uploads/casi-mail/casi-logo-mail.png",
    "fonts": "https://casinitiative.org/wp-content/uploads/casi-fonts/"
  }
}
